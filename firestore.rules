rules_version = '2';
// ANONYMITY GUARANTEE: clients NEVER read or write Firestore directly.
// Every access goes through the API, which runs as a service account and
// bypasses these rules. Anything reaching this file is an attempt to go
// around the API, and is denied unconditionally.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
