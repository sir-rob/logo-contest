# API environment — reference for a DEPLOYED environment.
# Copy to .env and fill in. For local emulator work use .env.local.example
# instead; it has the emulator hosts and a fake-clock switch already wired.
#
# Every variable the API reads is listed here (see apps/api/src/config.ts,
# which parses and validates them at startup and crashes on anything invalid).

NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8080

# Project id. FIREBASE_PROJECT_ID wins if both are set.
GCLOUD_PROJECT=n7-logo-contest
# Private bucket holding originals and renditions. Never public.
STORAGE_BUCKET=n7-logo-contest-logos

# Comma-separated list of email domains permitted to sign in. Exact, full-domain
# match — subdomains are NOT admitted and must be listed explicitly. An empty
# value is a startup error rather than a silent open door.
ALLOWED_DOMAINS=google.com

# Promoted to admin on first sign-in, then ignored.
BOOTSTRAP_ADMIN_EMAIL=you@google.com

# Where the magic link lands. Must be an authorised Firebase Auth domain.
APP_URL=https://n7-logo-contest.web.app
# Defaults to APP_URL when unset.
CORS_ORIGINS=https://n7-logo-contest.web.app

# The single contest this deployment serves by default.
DEFAULT_CONTEST_ID=north7

# Service-account JSON, inline, for environments without application-default
# credentials. Leave unset on Cloud Run, which supplies ADC.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- Local emulator wiring -------------------------------------------------
# Unset in production; setting them alongside NODE_ENV=production is a startup
# error. The local values live in .env.local.example:
#   FIRESTORE_EMULATOR_HOST=localhost:8080
#   FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
#   FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
